{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InfraBox Platform partial Config Context",
  "type": "object",
  "properties": {
    "infrabox_roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "chrony": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "sshd": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "packages_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.-]*$"
      }
    },
    "chrony_servers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
      }
    },
    "chrony_makestep": {
      "type": "boolean"
    },
    "sshd_log_level": {
      "enum": [
        "QUIET",
        "FATAL",
        "ERROR",
        "INFO",
        "VERBOSE"
      ]
    },
    "sshd_client_alive_interval": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600
    },
    "sshd_client_alive_count_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "chrony_pools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
      }
    },
    "chrony_dhcp_sources": {
      "type": "boolean"
    }
  },
  "patternProperties": {
    "^(?!(?:infrabox_|packages_|chrony_|sshd_)).+$": {}
  },
  "additionalProperties": false
}
